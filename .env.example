# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=nielekeze
DB_PORT=3306

# Security Keys
# Generate these with: php -r 'echo bin2hex(random_bytes(32));'
SECRET_KEY=generate_a_random_hex_string_here
ADMIN_SETUP_SECRET=generate_another_random_hex_string_here

# CORS Configuration
# For development: http://localhost:3000
# For production: https://yourdomain.com
# For multiple origins: https://yourdomain.com,https://www.yourdomain.com
# WARNING: Do NOT use wildcard (*) in production
ALLOWED_ORIGINS=http://localhost
