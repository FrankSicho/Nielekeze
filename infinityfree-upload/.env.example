# Database Configuration
DB_HOST=sql123.infinityfree.com
DB_USER=if0_12345678
DB_PASSWORD=your_secure_password_here
DB_NAME=if0_12345678_nielekeze
DB_PORT=3306

# Security Keys
# Generate these with: php -r 'echo bin2hex(random_bytes(32));'
SECRET_KEY=generate_a_random_hex_string_here
ADMIN_SETUP_SECRET=generate_another_random_hex_string_here

# CORS Configuration
# Current production domain: https://nielekeze.free.nf
# When moving to a custom domain, replace this value with that HTTPS domain.
# For a temporary migration period, use both domains separated by a comma.
# WARNING: Do NOT use wildcard (*) in production
ALLOWED_ORIGINS=https://nielekeze.free.nf
